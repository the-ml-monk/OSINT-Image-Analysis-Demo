# Azure AI Vision (Image Analysis / Read OCR) — F0 free tier is enough for a demo
AZURE_VISION_ENDPOINT=https://<your-vision-resource>.cognitiveservices.azure.com/
AZURE_VISION_KEY=<your-azure-vision-key>

# AI model for the briefing, badge/text reading and the image chat.
# Gemini is used if set (preferred); otherwise Groq.
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-3.8-flash
# GROQ_API_KEY=<optional-fallback>

# Serper.dev — Google search for corroborating names found in the image
SERPER_API_KEY=<your-serper-key>

# Optional: password-protect the app when hosted online (unset = open, for local use)
# APP_PASSWORD=<choose-a-password>
